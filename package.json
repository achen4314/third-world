{
  "name": "third-world",
  "version": "1.0.0",
  "private": true,
  "description": "第三世界 · 跨端综合运动训练软件（原型 + 数据库 schema + 可复现校验）",
  "scripts": {
    "check:env": "node tools/check-env.mjs --probe",
    "check:db": "node tools/db-check.cjs",
    "db:apply": "node tools/apply-remote.mjs",
    "db:verify": "node tools/apply-remote.mjs --verify-only",
    "db:apply:dry": "node tools/apply-remote.mjs --dry-run",
    "db:0003": "node tools/apply-sql.mjs supabase/migrations/20261114000003_storage_realtime.sql",
    "db:audit": "node tools/audit-db.mjs",
    "fn:check": "cd supabase/functions && deno check export-athlete-data/index.ts delete-athlete-data/index.ts device-oauth-start/index.ts oauth-callback/index.ts",
    "fn:test": "cd supabase/functions && deno test --allow-env _shared/crypto_test.ts",
    "serve": "python3 -m http.server 8799 --bind 127.0.0.1 --directory prototype",
    "mock:api": "node tools/mock-api.mjs --port 8791",
    "test:flows": "node tools/test-flows.mjs",
    "test:api": "node tools/smoke-api.mjs",
    "db:0005": "node tools/apply-sql.mjs supabase/migrations/20261114000005_auth_bridge.sql",
    "db:0006": "node tools/apply-sql.mjs supabase/migrations/20261114000006_signup_and_metrics.sql",
    "db:0007": "node tools/apply-sql.mjs supabase/migrations/20261114000007_plans_library_rules.sql",
    "db:0008": "node tools/apply-sql.mjs supabase/migrations/20261114000008_calculations.sql",
    "db:0009": "node tools/apply-sql.mjs supabase/migrations/20261114000009_metrics_cleanup.sql",
    "db:0010": "node tools/apply-sql.mjs supabase/migrations/20261114000010_timezone_backfill.sql",
    "db:0011": "node tools/apply-sql.mjs supabase/migrations/20261114000011_state_vs_daily.sql",
    "accounts": "node tools/accounts.mjs list",
    "seed:demo": "node tools/seed-demo.mjs",
    "q": "node tools/q.mjs",
    "set:key": "node tools/set-key.mjs",
    "db:0012": "node tools/apply-sql.mjs supabase/migrations/20261114000012_rest_day_decay.sql",
    "admin:console": "node deploy/admin-console.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "deno": "^2.9.6",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}