# 第三世界 · 环境变量模板
# ---------------------------------------------------------------------------
# 本文件提交进公开仓库，只放占位值。
# 真实值写同目录 `.env.local`（已被 .gitignore 的 `.env.*` 与 `*.local` 覆盖）。
#
# 编号对应 docs/06-接入信息需求与前置决策清单.md §3.1 的 C1–C11。
# 安全红线：
#   · SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY 绕过 RLS，仅服务端可用
#   · 上述密钥与 DB 密码一旦进入 git 历史或对话上下文即视为泄露，必须轮换
#   · 前端只能使用 PUBLISHABLE / ANON 级别 key
# ---------------------------------------------------------------------------

# ── C1 项目地址 ────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>

# ── C6 区域（决定延迟与数据出境判定，见 docs/06 D3）────────────────────────
SUPABASE_REGION=<region，如 us-east-1 / ap-southeast-1 / ap-northeast-1>

# ── C2 前端可公开 key（受 RLS 约束，泄露风险为「匿名可读公开数据」）──────────
# 新项目（2025 年后创建）为 sb_publishable_xxx，对应 Postgres 的 anon 角色
# 老项目为 anon JWT（eyJhbGciOi...），两者填其一即可
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ── C3 服务端密钥（仅服务端进程，绕过 RLS，对应 service_role 角色）──────────
# 新项目为 sb_secret_xxx；老项目为 service_role JWT。二选一。
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── C4 / C5 数据库连接串 ───────────────────────────────────────────────────
# pooler 走 6543（应用运行时）；直连走 5432（执行迁移）。密码填 URL 编码后的值。
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── C7 套餐与后端开关 ─────────────────────────────────────────────────────
# free = 无每日备份、无 PITR、闲置 7 天自动暂停（docs/06 §2.2）
SUPABASE_PLAN=free
# local = 本地 Postgres / DEMO；supabase = 走云项目
DATA_BACKEND=local

# ── C8 JWT Secret（仅自建服务端校验令牌时需要；用托管 Auth 可留空）──────────
SUPABASE_JWT_SECRET=

# ── C9 允许的回调地址（逗号分隔，含本地 + 预发布 + 生产）──────────────────
ALLOWED_REDIRECT_URLS=http://localhost:3000

# ── C10 Storage 桶规划 ────────────────────────────────────────────────────
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_IMPORTS=imports
STORAGE_BUCKET_EXPORTS=exports

# ── 缺口 D：设备授权（OAuth，凭据走厂商后台，不要填密码）────────────────────
# 未申请前留空，check-env 会把空值标记为「未接入」而非「配置错误」
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=

# ── 观测（可选）───────────────────────────────────────────────────────────
LOG_LEVEL=info
