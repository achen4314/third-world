# 第三世界 · 环境变量模板
# ---------------------------------------------------------------------------
# 本文件提交进公开仓库，只放占位值。
# 真实值写同目录 `.env.local`（已被 .gitignore 的 `.env.*` 与 `*.local` 覆盖）。
#
# 编号对应 docs/06-接入信息需求与前置决策清单.md §3.1 的 C1–C11。
# 安全红线：
#   · SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY 绕过 RLS，仅服务端可用
#   · 上述密钥与 DB 密码一旦进入 git 历史或对话上下文即视为泄露，必须轮换
#   · 前端只能使用 PUBLISHABLE / ANON 级别 key
# ---------------------------------------------------------------------------

# ── C1 项目地址 ────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>

# ── C6 区域（决定延迟与数据出境判定，见 docs/06 D3）────────────────────────
SUPABASE_REGION=<region，如 us-east-1 / ap-southeast-1 / ap-northeast-1>

# ── C2 前端可公开 key（受 RLS 约束，泄露风险为「匿名可读公开数据」）──────────
# 新项目（2025 年后创建）为 sb_publishable_xxx，对应 Postgres 的 anon 角色
# 老项目为 anon JWT（eyJhbGciOi...），两者填其一即可
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ── C3 服务端密钥（仅服务端进程，绕过 RLS，对应 service_role 角色）──────────
# 新项目为 sb_secret_xxx；老项目为 service_role JWT。二选一。
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── C4 / C5 数据库连接串 ───────────────────────────────────────────────────
# pooler 走 6543（应用运行时）；直连走 5432（执行迁移）。密码填 URL 编码后的值。
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── C7 套餐与后端开关 ─────────────────────────────────────────────────────
# free = 无每日备份、无 PITR、闲置 7 天自动暂停（docs/06 §2.2）
SUPABASE_PLAN=free
# local = 本地 Postgres / DEMO；supabase = 走云项目
DATA_BACKEND=local

# ── C8 JWT Secret（仅自建服务端校验令牌时需要；用托管 Auth 可留空）──────────
SUPABASE_JWT_SECRET=

# ── C9 允许的回调地址（逗号分隔，含本地 + 预发布 + 生产）──────────────────
ALLOWED_REDIRECT_URLS=http://localhost:3000

# ── C10 Storage 桶（已在 0003 迁移里建好，名称不可随意改）──────────────────
# 路径约定见 supabase/migrations/20261114000003_storage_realtime.sql 头部
STORAGE_BUCKET_ACTIVITY_FILES=activity-files
STORAGE_BUCKET_SESSION_VIDEOS=session-videos
STORAGE_BUCKET_EXPORTS=exports
STORAGE_BUCKET_AVATARS=avatars

# ── Edge Functions（0003 之后的函数层，见 supabase/functions/）──────────────
# 凭据加密密钥：32 字节的 base64 或 64 位 hex。生成：openssl rand -base64 32
# 一旦有真实令牌落库就不可更换（换了旧密文全部解不开），丢失等于所有厂商授权失效
ARC_CREDENTIAL_KEY=
# OAuth state 的 HMAC 密钥，至少 32 字符：openssl rand -hex 32
ARC_STATE_SECRET=
# 厂商回调地址：https://<project-ref>.supabase.co/functions/v1/oauth-callback
ARC_OAUTH_REDIRECT_URL=
# 授权完成后回跳 App 的 deep link
ARC_APP_DEEPLINK=thirdworld://oauth/done
# 前端来源白名单（生产必须收紧，不要留 *）
ARC_ALLOWED_ORIGIN=*

# 厂商 OAuth 端点（按需填，未填则函数返回 501 并列出缺哪几个变量）
ARC_ENODE_AUTHORIZE_URL=
ARC_ENODE_TOKEN_URL=
ARC_ENODE_CLIENT_ID=
ARC_ENODE_CLIENT_SECRET=
ARC_ENODE_SCOPE=
ARC_GARMIN_AUTHORIZE_URL=
ARC_GARMIN_TOKEN_URL=
ARC_GARMIN_CLIENT_ID=
ARC_GARMIN_CLIENT_SECRET=
ARC_GARMIN_SCOPE=
ARC_STRAVA_AUTHORIZE_URL=
ARC_STRAVA_TOKEN_URL=
ARC_STRAVA_CLIENT_ID=
ARC_STRAVA_CLIENT_SECRET=
ARC_STRAVA_SCOPE=

# ── 缺口 D：设备授权（OAuth，凭据走厂商后台，不要填密码）────────────────────
# 未申请前留空，check-env 会把空值标记为「未接入」而非「配置错误」
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=

# ── 观测（可选）───────────────────────────────────────────────────────────
LOG_LEVEL=info
