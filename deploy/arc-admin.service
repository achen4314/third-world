[Unit]
Description=第三世界 · 后台管理控制台（本机维护用，只监听回环）
Documentation=file:/opt/arc-training/docs/14-隔离契约-不影响另一个挂载点.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 以专用低权限用户运行：即使这个 HTTP 服务被攻破，它也读不到 Dify 的文件
# （Dify 属 root/docker）。唯一特权是一条 sudoers 白名单：重载 Caddy。
User=arcadmin
Group=arcadmin
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/arc-training
Environment=ARC_ADMIN_ROOT=/opt/arc-training
Environment=ARC_ADMIN_BIND=127.0.0.1
Environment=ARC_ADMIN_PORT=8787
# 口令放在 /etc/arc-training/admin.env（0600 root）。systemd 以 root 读取后再降权，
# 所以进程本身看不到明文文件，只能看到注入的环境变量。
EnvironmentFile=/etc/arc-training/admin.env
ExecStart=__NODE__ /opt/arc-training/deploy/admin-console.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# 只允许写自己的两个目录；/etc、/var/lib/docker、别人的站点目录一律只读
ReadWritePaths=/opt/arc-training/prototype /opt/arc-training/deploy/runtime
# 额外隔离：看不见 /opt 下与本项目无关的路径
InaccessiblePaths=/var/lib/docker /opt/dify

[Install]
WantedBy=multi-user.target
