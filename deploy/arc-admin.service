[Unit]
Description=第三世界 · 后台管理控制台（本机维护用，只监听回环）
Documentation=file:/opt/arc-training/docs/12-服务器与域名上线方案.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 说明：这个服务要执行 systemctl / caddy 校验 / 写 env.js，因此以 root 运行；
# 它只绑 127.0.0.1，对外必须经过 Caddy 的 HTTPS + Bearer 口令，攻击面仅限本机。
User=root
Group=root
WorkingDirectory=/opt/arc-training
Environment=ARC_ADMIN_ROOT=/opt/arc-training
Environment=ARC_ADMIN_BIND=127.0.0.1
Environment=ARC_ADMIN_PORT=8787
# 口令放在 /etc/arc-training/admin.env（0600），不要写进本文件、不要进 git
EnvironmentFile=/etc/arc-training/admin.env
ExecStart=__NODE__ /opt/arc-training/deploy/admin-console.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# ProtectSystem 不设为 strict：控制台需要 reload caddy、读 /etc/caddy
ProtectSystem=full
ReadWritePaths=/opt/arc-training/prototype /opt/arc-training/deploy/runtime /etc/caddy /var/log/caddy

[Install]
WantedBy=multi-user.target
